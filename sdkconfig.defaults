# ESP32-C5 目标
CONFIG_IDF_TARGET="esp32c5"

# 双频 Wi-Fi (2.4G + 5G)
CONFIG_SOC_WIFI_SUPPORT_5G=y

# SoftAP SSID 前缀（实际 SSID = <前缀>_<MAC后8位>）
CONFIG_PROV_AP_SSID_PREFIX="Safehalt"

# 当前开发板实际为 4MB Flash
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# 主任务栈
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# 日志级别
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# 分区表：双 OTA 分区（ota_0/ota_1），支持网页固件升级
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 应用回滚保护：新固件启动异常时自动回退到上一个可用版本
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# HTTP Server
CONFIG_HTTPD_MAX_URI_HANDLERS=12

# 关闭功耗节省（配网期间保持响应）
CONFIG_PM_ENABLE=n

# mbedTLS：Modbus 帧很小，减小 TLS 收发缓冲节省 RAM
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=4096
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
